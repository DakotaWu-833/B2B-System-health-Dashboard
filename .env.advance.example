# Copy settings into your ignored .env, alongside the UI_* values from .env.example.
REDIS_PASSWORD=
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen3.5:9b-q4_K_M
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_TIMEOUT=PT30S
AI_MAX_TOOL_CALLS=6
AI_REQUESTS_PER_MINUTE=20
LOGIN_REQUESTS_PER_MINUTE=10

# Bounded working buffers; retain the existing 8K chat context and output limit.
AI_CONTEXT_TOKENS=8192
AI_BATCH_SIZE=256
AI_EMBEDDING_CONTEXT_TOKENS=4096
AI_KEEP_ALIVE=PT1M
AI_EMBEDDING_KEEP_ALIVE=PT15S

# Apply these to the Ollama server process (Compose passes them through).
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=60s
OLLAMA_MAX_QUEUE=8
# Ollama 0.40.3 llama.cpp runner: cap the CPU prompt cache in MiB.
LLAMA_ARG_CACHE_RAM=256
