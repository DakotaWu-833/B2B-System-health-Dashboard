# Local MySQL defaults used by docker-compose.yml and the Spring Boot application.
MYSQL_DATABASE=system_health_dashboard
MYSQL_USER=dashboard_user
MYSQL_PASSWORD=dashboard_password
MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_PORT=3306

# Optional persisted demo user for local Sprint 1 authentication.
AUTH_SEED_ENABLED=false
AUTH_SEED_USERNAME=demo.operations
AUTH_SEED_PASSWORD=change-me-locally
AUTH_SEED_ROLE=OPERATIONS

# Use true only when HTTPS is enabled (normally false for localhost development).
SESSION_COOKIE_SECURE=false
