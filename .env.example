# Local MySQL defaults used by docker-compose.yml and the Spring Boot application.
MYSQL_DATABASE=system_health_dashboard
MYSQL_USER=dashboard_user
MYSQL_PASSWORD=dashboard_password
MYSQL_ROOT_PASSWORD=change-me-locally
MYSQL_PORT=3306

# Optional persisted demo user for local Sprint 1 authentication.
AUTH_SEED_ENABLED=false
AUTH_SEED_USERNAME=demo.operations
AUTH_SEED_PASSWORD=change-me-locally
AUTH_SEED_ROLE=OPERATIONS

# Optional dashboard demo data: 3 systems, 15 recent metrics and 4 alerts.
# Seeding is skipped when monitored systems already exist.
DEMO_DATA_SEED_ENABLED=false

# Use true only when HTTPS is enabled (normally false for localhost development).
SESSION_COOKIE_SECURE=false

# Optional Sprint 3 two-role local accounts. Existing passwords are preserved.
DEMO_ACCOUNTS_ENABLED=false
DEMO_OPERATIONS_USERNAME=demo.operations
DEMO_OPERATIONS_PASSWORD=
DEMO_MANAGEMENT_USERNAME=demo.management
DEMO_MANAGEMENT_PASSWORD=
# Synthetic readings for the three known seed systems; off outside local demonstrations.
DEMO_LIVE_METRICS_ENABLED=false
DEMO_METRIC_INTERVAL_MS=30000
METRIC_STALE_AFTER=PT5M

# SMTP is disabled until explicitly configured. Local Mailpit uses port 1026.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@dashboard.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
EMAIL_VERIFICATION_TTL=PT15M
EMAIL_RESEND_AFTER=PT1M
EMAIL_MAX_ATTEMPTS=5

# Opt-in archive of old non-latest metrics, with a bounded transaction.
METRIC_RETENTION_ENABLED=false
METRIC_RETAIN_FOR=P30D
METRIC_RETENTION_BATCH_SIZE=500
METRIC_RETENTION_INTERVAL_MS=600000

# Isolated verification Compose password must be set locally, never committed.
VERIFY_DB_PASSWORD=
VERIFY_MYSQL_PORT=3308
VERIFY_SMTP_PORT=1026
VERIFY_MAIL_UI_PORT=8026
