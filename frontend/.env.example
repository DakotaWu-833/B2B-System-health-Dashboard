# Leave empty during local Vite development to use the /api proxy.
VITE_API_BASE_URL=

# Local MySQL 8.4 demo backend. Other local backends may use http://localhost:8080.
# Copy this file to .env.local and restart Vite after changing the target.
# Keeping VITE_API_BASE_URL empty sends all APIs through this same-origin proxy.
BACKEND_PROXY_TARGET=http://127.0.0.1:8081
